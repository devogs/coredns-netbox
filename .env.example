# Copy to .env and adjust: cp .env.example .env

# --- Required ---
# NetBox base URL, without /api (the plugin appends /api/ipam/ip-addresses)
NETBOX_URL="http://netbox.example.com:8080"
# NetBox API token (read-only is enough)
NETBOX_TOKEN="change-me"

# --- Optional (defaults shown) ---
# Zone served from NetBox ("." = every name; a single value, e.g. "lab.local")
NETBOX_ZONES="."
# TTL of the answers built from NetBox (Go duration)
NETBOX_TTL="5m"
# Timeout of the NetBox API calls (Go duration)
NETBOX_TIMEOUT="5s"
# Resolver used for names NetBox does not know (single IP, or /etc/resolv.conf)
DNS_UPSTREAM="1.1.1.1"
# Cache duration in seconds
DNS_CACHE_TTL="30"
